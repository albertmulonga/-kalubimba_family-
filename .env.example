APP_NAME="Kalubimba Family"
APP_URL=http://localhost:3000

# PostgreSQL (local, Neon, Vercel Postgres, Supabase...)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/kalubimba_family
# Mettre "false" uniquement pour une base locale sans SSL
DATABASE_SSL=true

# Secret de signature des sessions (obligatoire en production)
AUTH_SECRET=changez-moi-avec-une-longue-chaine-aleatoire

# Stockage des fichiers sur Vercel (optionnel en local)
BLOB_READ_WRITE_TOKEN=

# Email de l'administrateur
ADMIN_EMAIL=adminkalubimba@gmail.com
